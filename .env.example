GEMINI_API_KEY=""
APP_URL="http://localhost"
DATABASE_URL="postgresql://novacloud:change-me@127.0.0.1:5432/novacloud"
SESSION_SECRET="replace-with-a-long-random-secret"
NODE_ENV="production"
PORT="3000"
COOKIE_SECURE="false"

# Nova-owned compute agent endpoint.
NOVA_AGENT_URL="http://127.0.0.1:9443"
NOVA_AGENT_TOKEN=""
NOVA_AGENT_VERIFY_TLS="true"

# Agent host configuration lives in /etc/novacloud-agent.env:
# NOVA_AGENT_CIDR=10.88.0.0/24
# NOVA_AGENT_DNS=1.1.1.1,8.8.8.8
# NOVA_AGENT_BIND=127.0.0.1 (set a management address for a remote controller)
